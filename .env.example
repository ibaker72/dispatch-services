# =============================================================================
# Environment variables — copy to .env.local for development.
# NEVER commit real credentials. Variables starting with NEXT_PUBLIC_ are sent
# to the browser; everything else stays on the server.
# =============================================================================

# ---- Application -------------------------------------------------------------
# development | test | staging | production. Production refuses development-only
# adapters (local storage, mock payments, email outbox) and requires CRON_SECRET
# and RATE_LIMIT_SALT.
APP_ENV=development
# Public origin used for canonical URLs, sitemaps, email links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: exposed to the browser Sentry SDK to label the environment.
NEXT_PUBLIC_APP_ENV=development

# ---- Supabase (Postgres, Auth, Storage) --------------------------------------
# Project URL and anon/publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role/secret key. SERVER ONLY — bypasses RLS. Used for anonymous
# application drafts, webhooks, jobs, auth admin and storage signing.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection — used only by scripts and tests (types, RLS gate, seeds).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---- Document storage --------------------------------------------------------
# supabase (default, private bucket "carrier-documents") | local (development only).
STORAGE_DRIVER=supabase
# Only for STORAGE_DRIVER=local:
LOCAL_STORAGE_DIR=.local-stack/storage
LOCAL_STORAGE_SIGNING_SECRET=change-me-local-only

# ---- Email (Resend) ----------------------------------------------------------
# resend | outbox (writes JSON files, development/E2E) | console (logs subject only).
# Defaults to resend when RESEND_API_KEY is set, otherwise console.
EMAIL_DRIVER=
RESEND_API_KEY=
# Must be on a domain verified in Resend (see docs/DEPLOYMENT.md → Resend DNS).
EMAIL_FROM="Dispatch Team <dispatch@yourdomain.com>"
EMAIL_REPLY_TO=
# Comma-separated staff addresses for new applications, support requests and daily summaries.
ADMIN_NOTIFICATION_EMAILS=
# Only for EMAIL_DRIVER=outbox:
EMAIL_DEV_OUTBOX_DIR=.local-stack/outbox

# ---- Payments (Stripe) -------------------------------------------------------
# stripe | mock (development/E2E only) | manual (no online payments).
# Defaults to stripe when STRIPE_SECRET_KEY is set, otherwise manual.
# Stripe collects ONLY the dispatch company's own invoice from the carrier.
PAYMENTS_DRIVER=
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# ---- Analytics (PostHog) — optional -----------------------------------------
# No autocapture, no session recording, no PII. Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional separate server key (defaults to NEXT_PUBLIC_POSTHOG_KEY).
POSTHOG_API_KEY=

# ---- Error monitoring (Sentry) — optional ------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time source map upload (CI/Vercel only).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Background jobs ---------------------------------------------------------
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set).
CRON_SECRET=
# Optional Inngest scheduler (preferred on Vercel Hobby, which limits cron frequency).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Security ----------------------------------------------------------------
# Random secret used to hash rate-limit keys and analytics ids (openssl rand -hex 32).
RATE_LIMIT_SALT=
# Optional Cloudflare Turnstile on public forms (honeypot + timing checks always apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra hosts allowed to invoke Server Actions (comma-separated), e.g. behind a proxy.
SERVER_ACTION_ALLOWED_ORIGINS=

# ---- Lease-on operations (keep false) ----------------------------------------
# Must stay false until the company holds real authority, insurance filings,
# BOC-3, a compliance administrator and an attorney-approved lease. Even when
# true, the database refuses to enable lease-on until that checklist is complete.
LEASE_ON_OPERATIONS_ENABLED=false
